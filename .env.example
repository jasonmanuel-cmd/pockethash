# DATABASE ENV - LOCAL DEVELOPMENT
# Local demo mode uses file:sqlite.db by default.

# DATABASE ENV - PRODUCTION (VERCEL / TURSO)
# Set POCKETHASH_USE_REMOTE=true to force Turso in local or production environments.
# Replace these with your Turso DB URL and Auth Token
# POCKETHASH_USE_REMOTE=true
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token-here

# LOYALTY SETTINGS (DO NOT CHANGE UNLESS REDEFINING VALUE)
# 1 USD = 1 PT
# 200 PTS = $20
# 500 PTS = $100
# 1000 PTS = $200
